{
  "vtkdir": "Slit_Post_VTK_Files",
  "pattern": "Slit_Particles_*.vtu",
  "output_interval": 0.5,
  "index_origin": 0,
  "time_offset": 0.0,
  "dem_radius": 0.4,
  "dpd_radius": 0.02,
